pipeline {
    agent any

    environment {
        DOCKER_USER = 'your-dockerhub-username'
        CRED_ID     = 'dockerhub-credentials-id'
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/your-repo/3tier-microservices.git'
            }
        }

        stage('Build & Push Backend') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', "${CRED_ID}") {
                        def backendImage = docker.build("${DOCKER_USER}/backend-api:${BUILD_NUMBER}", "./backend")
                        backendImage.push()
                        backendImage.push("latest")
                    }
                }
            }
        }

        stage('Build & Push Frontend') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', "${CRED_ID}") {
                        def frontendImage = docker.build("${DOCKER_USER}/frontend-ui:${BUILD_NUMBER}", "./frontend")
                        frontendImage.push()
                        frontendImage.push("latest")
                    }
                }
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh 'kubectl apply -f k8s/mongo.yaml'
                sh 'kubectl apply -f k8s/backend.yaml'
                sh 'kubectl apply -f k8s/frontend.yaml'
                sh 'kubectl rollout restart deployment/backend-api'
                sh 'kubectl rollout restart deployment/frontend-ui'
            }
        }
    }
}
